# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"

# Email (Magic Link) - Configure with your SMTP provider
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="Birthday Dashboard <noreply@tudominio.com>"

# App
NEXT_PUBLIC_APP_NAME="Birthday Dashboard"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Web Push (VAPID) - recordatorios de cumpleaños
# Generar con: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY="generate_me"
VAPID_PRIVATE_KEY="generate_me"
VAPID_CONTACT="mailto:tu-email@example.com"
# Secreto compartido para que el cron dispare el envío de recordatorios
PUSH_WEBHOOK_SECRET="cambia-este-secreto"